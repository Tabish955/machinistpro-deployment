# Copy to .env.local and fill in real values. .env* files are gitignored.

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx    # server only

# Public (client-side) mirror — Vite injects these into the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── Mughal upstream auth ──────────────────────────────────────────────────
MUGHAL_APP_NAME=MachinistPro
MUGHAL_OWNER_ID=your-owner-id
MUGHAL_VERSION=1.0
# MUGHAL_APP_SECRET — used as a pepper fallback for hashing; leave unset to
# fall back to SUPABASE_SERVICE_ROLE_KEY first 32 chars.

# ─── Session pepper ────────────────────────────────────────────────────────
# Recommended: an explicit random 64+ char hex string for token hashing.
# If unset, falls back to MUGHAL_APP_SECRET, then to SUPABASE_SERVICE_ROLE_KEY.
SESSION_PEPPER=

# ─── Trial pepper ─────────────────────────────────────────────────────────
TRIAL_PEPPER=
